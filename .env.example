# RAJENDRA STUDIO & FRAMING - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your credentials

# Supabase Cloud Database Configuration
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Cloud Mail Configuration (for production OTP & Customer Order notifications)
# For Gmail, generate a 16-character App Password under Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=rajendrastudioframing@gmail.com
GMAIL_APP_PASS=your-16-char-app-password

# Session Security Secret (optional, random string for signing customer session tokens)
CUSTOMER_SESSION_SECRET=your-random-session-secret-key-here

# Server Port (default: 5000)
PORT=5000
