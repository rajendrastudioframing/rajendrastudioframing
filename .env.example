# RAJENDRA STUDIO & FRAMING - ENVIRONMENT CONFIGURATION
# Copy these variables to your Vercel Project Settings -> Environment Variables

PORT=5000

# Brevo Channel 1: Shop, Customer & Admin Logins, Pick Up Ready
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=shop@rajendrastudioandgifts.in
BREVO_SENDER_NAME=Rajendra Studio & Gifts
SHOP_NOTIFICATION_EMAIL=shop@rajendrastudioandgifts.in

# Brevo Channel 2: Order Confirmations & Order Accepted by Admin
BREVO_ORDER_API_KEY=your-brevo-order-api-key-here
BREVO_ORDER_EMAIL=order@rajendrastudioandgifts.in
BREVO_ORDER_NAME=Rajendra Studio Orders
ORDER_NOTIFICATION_EMAIL=order@rajendrastudioandgifts.in

# Studio Admin Emails
ADMIN_EMAIL=shop@rajendrastudioandgifts.in
SECONDARY_ADMIN_EMAIL=order@rajendrastudioandgifts.in

# Studio Contact Information
STUDIO_PHONE=+91 95107 57513
STUDIO_WHATSAPP=919510757513


# Supabase Cloud Database Configuration (Optional / If using Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Session Security Secret
CUSTOMER_SESSION_SECRET=your-random-session-secret-key-here
