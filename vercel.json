{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/categories/(.*)",
      "destination": "/api/categories?id=$1"
    },
    {
      "source": "/api/categories",
      "destination": "/api/categories"
    },
    {
      "source": "/api/admin/categories/(.*)",
      "destination": "/api/admin/categories?id=$1"
    },
    {
      "source": "/api/admin/categories",
      "destination": "/api/admin/categories"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    }
  ]
}
