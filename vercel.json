{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**": {
      "includeFiles": "data/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/categories",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    }
  ]
}
